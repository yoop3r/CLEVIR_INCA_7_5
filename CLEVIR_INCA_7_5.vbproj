<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <StartupObject>CLEVIR_INCA_7_5.My.MyApplication</StartupObject>
    <MyType>WindowsForms</MyType>
    <OptionStrict>On</OptionStrict>
    <ApplicationManifest>My Project\app.manifest</ApplicationManifest>
    <ApplicationIcon>GM_ResidentClient_256px.ico</ApplicationIcon>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <PublishUrl>publish\</PublishUrl>
    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <UpdateEnabled>false</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateInterval>7</UpdateInterval>
    <UpdateIntervalUnits>Days</UpdateIntervalUnits>
    <UpdatePeriodically>false</UpdatePeriodically>
    <UpdateRequired>false</UpdateRequired>
    <MapFileExtensions>true</MapFileExtensions>
    <ApplicationRevision>0</ApplicationRevision>
    <ApplicationVersion>1.0.0.0</ApplicationVersion>
    <UseApplicationTrust>false</UseApplicationTrust>
    <BootstrapperEnabled>false</BootstrapperEnabled>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <UseWinFormsOutOfProcDesigner>True</UseWinFormsOutOfProcDesigner>
    <!-- Keeps the WinForms designer itself DPI-unaware (VS 2022 17.8+ feature) so opening forms
         on HiDPI monitors doesn't rewrite AutoScaleDimensions/control layout in the *.Designer.vb
         files. Does not affect runtime DPI behavior, which is controlled separately via
         My Project\Application.myapp (HighDpiMode). See
         https://github.com/dotnet/winforms/blob/main/docs/designer/designer-high-dpi-mode.md -->
    <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
    <DocumentationFile>CLEVIR_INCA_7_5.xml</DocumentationFile>
    <Configurations>All;Debug;Release</Configurations>
    <!-- Explicit so Visual Studio's project system (Configuration Manager / solution load
         validation) recognizes Debug|x64 and Release|x64 as real configurations. SDK-style
         projects derive their known configuration set from Configurations x Platforms, not
         from the raw Condition="'$(Configuration)|$(Platform)'=='...'" PropertyGroups below -
         without this, Platforms silently defaulted to AnyCPU only, and the solution's x64
         mappings for this project were flagged as referencing configurations that "do not
         exist" even though the conditioned PropertyGroups build fine from the command line. -->
    <Platforms>AnyCPU;x64</Platforms>
    <!-- Single-targeted (net10.0-windows only): keep the classic flat output layout
         (bin\x64\Debug\ with no TFM subfolder) so CLEVIR_7.5 Installation\Product.wxs
         (which hardcodes bin\x64\$(var.Configuration)\ per file) keeps working unchanged. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Hoisted from 6 identical per-Configuration|Platform PropertyGroups below (Debug/Release
         x AnyCPU/x64, plus All|AnyCPU and All|x64) - value never varied across configurations,
         so it is set once here unconditionally to avoid duplication/configuration drift. -->
    <RegisterForComInterop>False</RegisterForComInterop>
  </PropertyGroup>
  <ItemGroup Label="Exclude foreign/vendor directories swept in by implicit SDK-style globbing (not part of this project's original item list)">
    <!-- Separate solution projects with their own project files - not part of this VB project -->
    <None Remove="NAVsdk\**" />
    <None Remove="HesaiWrapper\**" />
    <None Remove="PcapEventBridge\**" />
    <!-- Legacy NuGet packages.config cache folder - superseded by PackageReference, not project content -->
    <None Remove="packages\**" />
    <!-- Leftover backup folder from a prior automated NuGet PackageReference migration -->
    <None Remove="MigrationBackup\**" />
    <!-- Native build output directory at repo root (distinct from this project's own bin\x64 output) -->
    <None Remove="x64\**" />
    <!-- NAVsdk\Examples\...\NavLibWPFExample ships its own vendor App.xaml/MainWindow.xaml sample.
         Now that UseWPF is enabled (WinForms -> WPF migration), SDK-style default globbing would
         also pull these in as Page/ApplicationDefinition/Compile items belonging to *this* project,
         producing a broken generated App.g.vb with no matching hand-written partial class.
         NAVsdk is vendor/example content, not part of this project - exclude the WPF item types too. -->
    <Page Remove="NAVsdk\**" />
    <ApplicationDefinition Remove="NAVsdk\**" />
    <Compile Remove="NAVsdk\**\*.xaml.vb" />
    <Resource Remove="NAVsdk\**" />
  </ItemGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DocumentationFile>CLEVIR_INCA_7_5.xml</DocumentationFile>
    <NoWarn>42353,42354,42355,MSB3277</NoWarn>
    <PlatformTarget>x64</PlatformTarget>
    <RemoveIntegerChecks>true</RemoveIntegerChecks>
    <WarningsAsErrors>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036</WarningsAsErrors>
    <UseWinFormsOutOfProcDesigner>True</UseWinFormsOutOfProcDesigner>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DefineDebug>false</DefineDebug>
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DocumentationFile>CLEVIR_INCA_7_5.xml</DocumentationFile>
    <NoWarn>42353,42354,42355,MSB3277</NoWarn>
    <PlatformTarget>x64</PlatformTarget>
    <RemoveIntegerChecks>true</RemoveIntegerChecks>
    <WarningsAsErrors>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036</WarningsAsErrors>
    <UseWinFormsOutOfProcDesigner>True</UseWinFormsOutOfProcDesigner>
  </PropertyGroup>
  <PropertyGroup>
    <ManifestCertificateThumbprint>40676BB0FF1E599B264E65A5C15C01355F752451</ManifestCertificateThumbprint>
  </PropertyGroup>
  <PropertyGroup>
    <ManifestKeyFile>CLEVIR_INCA_7_5_4_TemporaryKey.pfx</ManifestKeyFile>
  </PropertyGroup>
  <PropertyGroup>
    <GenerateManifests>false</GenerateManifests>
  </PropertyGroup>
  <PropertyGroup>
    <SignManifests>true</SignManifests>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <OutputPath>bin\x64\Debug\</OutputPath>
    <RemoveIntegerChecks>true</RemoveIntegerChecks>
    <DocumentationFile>CLEVIR_INCA_7_5.xml</DocumentationFile>
    <NoWarn>42353,42354,42355,MSB3277</NoWarn>
    <WarningsAsErrors>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036</WarningsAsErrors>
    <UseWinFormsOutOfProcDesigner>True</UseWinFormsOutOfProcDesigner>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
    <RunCodeAnalysis>false</RunCodeAnalysis>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\x64\Release\</OutputPath>
    <RemoveIntegerChecks>true</RemoveIntegerChecks>
    <DocumentationFile>CLEVIR_INCA_7_5.xml</DocumentationFile>
    <NoWarn>42353,42354,42355,MSB3277</NoWarn>
    <WarningsAsErrors>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036</WarningsAsErrors>
    <UseWinFormsOutOfProcDesigner>True</UseWinFormsOutOfProcDesigner>
  </PropertyGroup>
  <PropertyGroup>
    <TargetZone>LocalIntranet</TargetZone>
    <!-- Enabled for the incremental WinForms -> WPF migration (side-by-side / strangler-fig approach).
         WPF Window-derived pilot forms coexist with the remaining WinForms forms in this same
         project; UseWindowsForms above remains true so both UI stacks are available. -->
    <UseWPF>True</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="incacom, Version=20.0.0.0, Culture=neutral, PublicKeyToken=c9b6e760b808c9f9, processorArchitecture=AMD64">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>lib\Interop\incacom.dll</HintPath>
    </Reference>
    <Reference Include="Interop.Scripting, Version=1.0.0.0, Culture=neutral, processorArchitecture=MSIL">
      <HintPath>lib\Interop\Interop.Scripting.dll</HintPath>
    </Reference>
    <Reference Include="RCI2dotNet, Version=7.3.0.21245, Culture=neutral, processorArchitecture=AMD64">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>lib\Interop\RCI2dotNet.dll</HintPath>
    </Reference>
    <!-- No modern replacement is shipped by Microsoft for the WinForms Chart control, so this
         still binds to the .NET Framework 4.8 Reference Assemblies. $(MSBuildProgramFiles32) is
         a reserved MSBuild property that resolves to "Program Files (x86)" (or "Program Files" on
         a 32-bit OS) - unlike a hardcoded relative path, it does not depend on the repo's folder
         depth or drive letter. -->
    <Reference Include="System.Windows.Forms.DataVisualization">
      <HintPath>$(MSBuildProgramFiles32)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.8\System.Windows.Forms.DataVisualization.dll</HintPath>
    </Reference>
  </ItemGroup>
