<Project Sdk="Microsoft.NET.Sdk">

  <!-- Characterization tests for logic extracted from GmResidentClient (see
       GM_ResidentClient_Refactor_Plan.md, Phase 2). Targets the same TFM/bitness as the app. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
    <OptionStrict>On</OptionStrict>
    <RootNamespace>CLEVIR_INCA_7_5.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CLEVIR_INCA_7_5.vbproj" />
  </ItemGroup>

</Project>
