<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.diagnostics>
    <sources>
      <source name="DefaultSource" switchName="DefaultSwitch">
        <listeners>
          <add name="FileLog" />
        </listeners>
      </source>
    </sources>
    <switches>
      <!-- Production: Warning | Development: Verbose -->
      <add name="DefaultSwitch" value="Warning" />
    </switches>
    <sharedListeners>
      <add name="FileLog" type="Microsoft.VisualBasic.Logging.FileLogTraceListener, Microsoft.VisualBasic, Version=8.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL" initializeData="FileLogWriter" location="Custom" customLocation="C:\HB" autoFlush="true" maxFileSize="10000000" />
    </sharedListeners>
  </system.diagnostics>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!-- ✅ Performance optimizations for multi-threaded INCA/LiDAR operations -->
    <gcServer enabled="true" />
    <gcConcurrent enabled="true" />
    <ThrowUnobservedTaskExceptions enabled="false" />
    <!--
      Binding redirects reconciled 2026-07-03 (task 06-binding-redirect-review, .NET 10 upgrade).
      This app now targets net10.0-windows (CoreCLR), not .NET Framework. CoreCLR resolves assembly
      references via the app's .deps.json/.runtimeconfig.json (trusted-assembly list), NOT via the
      legacy Fusion-style <assemblyBinding><bindingRedirect> mechanism below - AutoGenerateBindingRedirects
      defaults to true only for .NETFramework TFMs, so it is inactive here and the RAR conflict/auto-redirect
      diagnostics that produce MSB3836 do not run for this project. Empirically verified via a clean
      MSBuild.exe build (build_output_36.log, run before this reconciliation): 0 MSB3836 warnings, 3
      pre-existing unrelated warnings (SYSLIB0021/SYSLIB0022 obsolete-crypto, tracked under task
      07-crypto-removal). Net effect: the entries below have no runtime effect on assembly resolution
      today. Of the original 12 hand-authored redirects, 9 targeted packages with no corresponding
      PackageReference left in this project at all: 8 (System.Runtime.CompilerServices.Unsafe,
      System.Buffers, System.Memory, System.Threading.Tasks.Extensions, System.Numerics.Vectors,
      System.Security.AccessControl, System.Security.Principal.Windows, System.Text.Encoding.CodePages)
      were explicitly removed as direct PackageReferences in 05-package-updates; the 9th
      (Microsoft.Win32.Registry) has no PackageReference in this project's SDK-style history at all
      (absent from 05-package-updates' removal record too) and appears to be a defensive/legacy redirect
      with no corresponding direct package ever added. Confirmed via project.assets.json that none of
      these 9 appear anywhere in the net10.0-windows resolved dependency closure (their types now come
      from the shared framework itself where still needed), so those entries were removed as dead weight
      rather than version-corrected. The remaining 3 entries below
      target packages still directly referenced by this project and are retained (one corrected) purely
      for documentation of expected versions / as a no-cost safety net, since they are harmless even
      though inert. The assessment's "missing redirect for System.IO.Compression" was assessed and
      intentionally NOT added: System.IO.Compression is a <Reference> (not a versioned NuGet package)
      that resolves to the net10.0-windows shared framework (v10.0.0.0) post-retarget - the assessment's
      "v4.2.0.0" finding predates task 04's TFM retarget and no longer applies; the only System.IO.Compression-
      related package still referenced (runtime.native.System.IO.Compression) ships native libraries only,
      with no managed assembly to redirect. See progress-details.md in this task's folder for the full
      12-entry disposition table.
    -->
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!-- Azure.Core: still a direct PackageReference (1.57.0). Corrected newVersion from stale 1.51.1.0
           to 1.57.0.0 to match the actual resolved/installed assembly version (was flagged as both an
           MSB3836-mandatory conflict and a potential forced-downgrade). -->
      <dependentAssembly>
        <assemblyIdentity name="Azure.Core" publicKeyToken="92742159e12e44c8" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.57.0.0" newVersion="1.57.0.0" />
      </dependentAssembly>
      <!-- PacketDotNet: still a direct PackageReference (1.4.9-pre53). Assembly version is 1.4.9.0
           regardless of the "-pre53" package suffix, so this redirect already matched - retained as-is. -->
      <dependentAssembly>
        <assemblyIdentity name="PacketDotNet" publicKeyToken="451414c7667b2a58" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.4.9.0" newVersion="1.4.9.0" />
      </dependentAssembly>
      <!-- Newtonsoft.Json (used by NAudio/Pcap.Net): still a direct PackageReference (13.0.4).
           Newtonsoft.Json keeps its assembly version pinned at 13.0.0.0 across all 13.x.y releases,
           so this redirect already matched - retained as-is. -->
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <appSettings>
    <!-- ✅ CLEVIR Runtime Configuration Settings -->
    <add key="APICommErrorMsgDelayTime" value="90" />
    <add key="RecordFileDurationMinutes" value="5" />
    <add key="CompressMF4" value="true" />
    <add key="CompressPCAP" value="true" />
    <add key="DeleteAfterCompression" value="false" />
    <add key="CompressionLevel" value="1" />
    <add key="LidarCaptureEnabled" value="false" />
    <add key="AudioToTextConversion" value="false" />
    <add key="MaxCameras" value="9" />
    <add key="BaseDataCollectionPath" value="C:\HB" />
  </appSettings>
</configuration>