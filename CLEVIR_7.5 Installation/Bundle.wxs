<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
	 xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
	 xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx">

  <Bundle Name="CLEVIR INCA 7.5 Setup"
		  Version="$(var.ProductVersion)"
		  Manufacturer="Client Solutions"
		  UpgradeCode="8C1E3F2A-6B4D-4E7A-9C1F-2D5B7A9E3C10">

	<!-- Standard WiX bootstrapper UI: shows a progress bar during install and a final
		 success/failure page, so the person running the installer gets visible
		 confirmation instead of a silent no-feedback install. "hyperlinkLicense" is the
		 full/standard wixstdba theme with progress + final result page; leaving
		 LicenseUrl empty suppresses the license hyperlink since no EULA is required. -->
	<BootstrapperApplication>
	  <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense" LicenseUrl="" />
	</BootstrapperApplication>

	<!--
	  .NET 10 Windows Desktop Runtime (x64) detection.
	  DotNetCoreSearch returns the highest installed Microsoft.WindowsDesktop.App 10.x version
	  (empty if none). Any 10.x satisfies the app (runtimeconfig requires 10.0.0 with patch
	  roll-forward), so the embedded runtime is only installed when no 10.x is present.
	-->
	<netfx:DotNetCoreSearch Id="Dotnet10DesktopRuntimeDetect"
							RuntimeType="desktop"
							Platform="x64"
							MajorVersion="10"
							Variable="Dotnet10DesktopRuntimeVersion" />

	<Chain>
	  <!-- Install the .NET 10 Windows Desktop Runtime only if not already present -->
	  <ExePackage Id="DotNet10DesktopRuntime"
				  Name="Redist\windowsdesktop-runtime-10.0.12-win-x64.exe"
				  SourceFile="Redist\windowsdesktop-runtime-10.0.12-win-x64.exe"
				  InstallArguments="/install /quiet /norestart"
				  Permanent="yes"
				  Vital="yes"
				  DetectCondition="Dotnet10DesktopRuntimeVersion &gt;= v10.0.0" />

	  <!-- Chain the existing CLEVIR INCA 7.5 MSI, built by CLEVIR_Installer.wixproj -->
	  <MsiPackage Id="CLEVIR_INCA_MSI"
				  SourceFile="bin\$(var.Configuration)\CLEVIR_7.5_Setup.msi"
				  Vital="yes" />
	</Chain>

  </Bundle>
</Wix>
